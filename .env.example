DJANGO_SECRET_KEY=dev-secret-key-change-in-production-edu-platform-2026
DEBUG=True
DATABASE_URL=postgres://edu:edu_password_change_me@localhost:5432/eduplatform
# для sqlite оставь пустым: DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
VITE_API_URL=http://localhost:8001
# Для прод (Render/любой хостинг) — ПЕРЕОПРЕДЕЛИ ОБА:
# CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com,https://your-frontend.vercel.app
# VITE_API_URL=https://your-api.onrender.com  (без /api на конце)
# Важно: собери фронт ПОСЛЕ изменения VITE_API_URL (npm run build), иначе уйдёт на localhost.
# Google Gemini для генерации вопросов (https://aistudio.google.com/apikey, бесплатно).
# Без ключа generate честно работает в офлайн-режиме (source='offline').
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
